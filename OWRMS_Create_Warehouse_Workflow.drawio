        <!-- Owner: can re-submit hidden -->
        <mxCell id="O_hidden" value="Owner can re-submit&#xa;HIDDEN warehouse&#xa;for re-approval" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#F5F5F5;strokeColor=#999;fontColor=#666;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1560" width="160" height="45" as="geometry" />
