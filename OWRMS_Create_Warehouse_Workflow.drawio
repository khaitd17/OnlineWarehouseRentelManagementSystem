        <!-- HIDE -->
        <mxCell id="SYS_hide" value="HIDE:&#xa;APPROVED → HIDDEN&#xa;(temporarily hide&#xa;from public listing)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="275" y="1530" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e30" value="Hide" style="" edge="1" source="A_action" target="SYS_hide" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SHOW -->
        <mxCell id="SYS_show" value="SHOW:&#xa;HIDDEN → APPROVED&#xa;(re-show warehouse&#xa;on public listing)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="275" y="1620" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e31" value="Show" style="" edge="1" source="A_action" target="SYS_show" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DELETE -->
        <mxCell id="SYS_delete" value="DELETE:&#xa;Any status → DELETED&#xa;(soft-delete)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="275" y="1710" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e32" value="Delete" style="" edge="1" source="A_action" target="SYS_delete" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="1660" />
              <mxPoint x="580" y="1735" />
            </Array>
          </mxGeometry>
