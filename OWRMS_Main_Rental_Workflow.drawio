<mxfile host="app.diagrams.net" agent="Antigravity" version="26.0">
  <diagram id="rental-workflow" name="Main Rental Workflow">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="Online Warehouse Rental Management System" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="10" width="380" height="30" as="geometry" />
        </mxCell>

        <!-- SWIM LANE HEADERS -->
        <mxCell id="header_renter" value="Renter" style="shape=mxgraph.flowchart.annotation_2;align=center;labelPosition=center;pointerEvents=1;fontSize=14;fontStyle=1;verticalAlign=middle;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="header_system" value="OWRMS System" style="shape=mxgraph.flowchart.annotation_2;align=center;labelPosition=center;pointerEvents=1;fontSize=14;fontStyle=1;verticalAlign=middle;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="50" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="header_owner" value="Warehouse Owner" style="shape=mxgraph.flowchart.annotation_2;align=center;labelPosition=center;pointerEvents=1;fontSize=14;fontStyle=1;verticalAlign=middle;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="50" width="220" height="30" as="geometry" />
        </mxCell>

        <!-- Lane backgrounds -->
        <mxCell id="bg_renter" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCCCCC;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="220" height="2270" as="geometry" />
        </mxCell>
        <mxCell id="bg_system" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCCCCC;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="80" width="220" height="2270" as="geometry" />
        </mxCell>
        <mxCell id="bg_owner" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCCCCC;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="80" width="220" height="2270" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- START                                   -->
        <!-- ═══════════════════════════════════════ -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="140" y="100" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- PHASE 1: RENTAL REQUEST                 -->
        <!-- ═══════════════════════════════════════ -->

        <mxCell id="R1" value="View available warehouses&#xa;&amp; select preferred one" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="140" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e01" style="" edge="1" source="start" target="R1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R2" value="Fill in and Submit&#xa;Rental Request" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="210" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e02" style="" edge="1" source="R1" target="R2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S1" value="Rental request created&#xa;(Status: PENDING)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="210" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e03" style="" edge="1" source="R2" target="S1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S2" value="Send rental request&#xa;notification to&#xa;Warehouse Owner" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="280" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e04" style="" edge="1" source="S1" target="S2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="O1" value="Receive notification&#xa;&amp; review rental request" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="280" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e05" style="" edge="1" source="S2" target="O1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="O2" value="Approve&#xa;request?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="595" y="355" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e06" style="" edge="1" source="O1" target="O2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- REJECT PATH -->
        <mxCell id="O3" value="Reject the request&#xa;(enter reason)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="470" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e07" value="No" style="" edge="1" source="O2" target="O3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S3" value="Update request → REJECTED&#xa;Send rejection notification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="465" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e08" style="" edge="1" source="O3" target="S3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R3" value="Receive rejection&#xa;notification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="470" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e09" style="" edge="1" source="S3" target="R3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="end_reject" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="137" y="530" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="" edge="1" source="R3" target="end_reject" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- APPROVE PATH -->
        <mxCell id="O4" value="Approve request&#xa;(set monthly rent, deposit,&#xa;duration, terms,&#xa;assign warehouse zone)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="570" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="Yes" style="" edge="1" source="O2" target="O4" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="390" />
              <mxPoint x="740" y="605" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="S4" value="Update request → APPROVED&#xa;Create Rental Contract&#xa;(Status: DRAFT)&#xa;Send email to Renter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="570" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="" edge="1" source="O4" target="S4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- PHASE 2: CONTRACT NEGOTIATION           -->
        <!-- ═══════════════════════════════════════ -->

        <mxCell id="O5" value="Send contract draft&#xa;to Renter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="690" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="" edge="1" source="S4" target="O5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S5" value="Update contract →&#xa;NEGOTIATING&#xa;Create Contract Version&#xa;Send notification &amp; email" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="755" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="" edge="1" source="O5" target="S5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R4" value="Receive notification &amp;&#xa;review contract draft" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="768" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e15" style="" edge="1" source="S5" target="R4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R6" value="Agree with&#xa;contract&#xa;terms?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="115" y="840" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="" edge="1" source="R4" target="R6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- REVISION LOOP -->
        <mxCell id="R7" value="Request contract revision&#xa;(select section,&#xa;enter comment)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="950" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="No" style="" edge="1" source="R6" target="R7" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S6" value="Update contract →&#xa;REVISION_REQUESTED&#xa;Create Revision Thread" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="945" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e18" style="" edge="1" source="R7" target="S6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="O6" value="Receive revision request&#xa;notification &amp; email" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="950" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e19" style="" edge="1" source="S6" target="O6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="O7" value="Reply to revision &amp;&#xa;update contract terms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="1020" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e20" style="" edge="1" source="O6" target="O7" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S7" value="Save updated terms&#xa;Create new Contract Version&#xa;Notify Renter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="1015" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e21" style="" edge="1" source="O7" target="S7" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R8" value="View updated&#xa;contract version" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="1025" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e22" style="" edge="1" source="S7" target="R8" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Loop back -->
        <mxCell id="e23" style="curved=1;" edge="1" source="R8" target="R6" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="50" y="1045" />
              <mxPoint x="50" y="875" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- OWNER: Approve for signing -->
        <mxCell id="O8" value="Approve&#xa;for&#xa;signing?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="595" y="1110" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e24" value="Yes" style="" edge="1" source="R6" target="O8" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="240" y="875" />
              <mxPoint x="240" y="845" />
              <mxPoint x="750" y="845" />
              <mxPoint x="750" y="1145" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="S8" value="Check all&#xa;Revision Threads&#xa;resolved?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="345" y="1110" width="110" height="75" as="geometry" />
        </mxCell>
        <mxCell id="e25" style="" edge="1" source="O8" target="S8" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e26" value="Open threads remain" style="curved=1;fontStyle=2;fontSize=10;" edge="1" source="S8" target="O6" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="1110" />
              <mxPoint x="510" y="970" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="S9" value="Update contract →&#xa;APPROVED_FOR_SIGNING&#xa;Send notification &amp; email&#xa;to Renter &amp; Owner" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="1230" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e27" value="All resolved" style="" edge="1" source="S8" target="S9" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- PHASE 3: CONTRACT SIGNING               -->
        <!-- ═══════════════════════════════════════ -->

        <mxCell id="R9" value="Receive notification:&#xa;contract is ready to sign" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="1340" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e28" style="" edge="1" source="S9" target="R9" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R10" value="Agree&#xa;to sign?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="115" y="1410" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e29" style="" edge="1" source="R9" target="R10" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DECLINE -->
        <mxCell id="R_decline" value="Decline to sign&#xa;(enter reason)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="1520" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e30" value="No" style="" edge="1" source="R10" target="R_decline" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S_cancel" value="Update contract →&#xa;CANCELLED&#xa;Create Cancellation Log&#xa;Send notification to Owner" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="1510" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e31" style="" edge="1" source="R_decline" target="S_cancel" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="end_cancel" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="378" y="1595" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="e32" style="" edge="1" source="S_cancel" target="end_cancel" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SIGN PATH -->
        <mxCell id="R11" value="Sign contract electronically&#xa;(Signature Pad)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="1660" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e33" value="Yes" style="" edge="1" source="R10" target="R11" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="50" y="1445" />
              <mxPoint x="50" y="1680" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="S10" value="Generate PDF&#xa;with Renter's signature&#xa;Update contract →&#xa;PENDING_OWNER_SIGNATURE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="1650" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e34" style="" edge="1" source="R11" target="S10" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S10_notif" value="Send notification to Owner:&#xa;&quot;Renter has signed,&#xa;please review and sign&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="1740" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e35" style="" edge="1" source="S10" target="S10_notif" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="O9" value="Receive notification:&#xa;Renter has signed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="1745" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e36" style="" edge="1" source="S10_notif" target="O9" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="O10" value="Sign contract electronically&#xa;(Owner Signature Pad)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="1815" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e37" style="" edge="1" source="O9" target="O10" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CONTRACT ACTIVE -->
        <mxCell id="S11" value="Generate final PDF&#xa;with both signatures&#xa;Update contract → ACTIVE&#xa;Assign equipment to contract&#xa;Create first-term invoice&#xa;(if start date ≤ 5 days)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="295" y="1900" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="e38" style="" edge="1" source="O10" target="S11" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S_notif_active" value="Send notification to Renter:&#xa;&quot;Contract is now ACTIVE&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="2025" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e39" style="" edge="1" source="S11" target="S_notif_active" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R_active" value="Receive notification:&#xa;contract is ACTIVE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="2025" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e40" style="" edge="1" source="S_notif_active" target="R_active" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="O_active" value="Receive notification:&#xa;contract is ACTIVE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="2025" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e41" style="" edge="1" source="S_notif_active" target="O_active" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="end_ref" value="Proceed to&#xa;Contract Payment&#xa;Workflow" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#666666;dashed=1;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="85" y="2100" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e42" style="dashed=1;strokeColor=#999999;" edge="1" source="R_active" target="end_ref" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="end_success" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="137" y="2175" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="e43" style="" edge="1" source="end_ref" target="end_success" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
