<mxfile host="app.diagrams.net" agent="Antigravity" version="26.0">
  <diagram id="inbound-workflow" name="Inbound (Warehouse Receipt) Workflow">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="Online Warehouse Rental Management System&#xa;Inbound (Warehouse Receipt) Workflow" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="10" width="420" height="40" as="geometry" />
        </mxCell>

        <!-- SWIM LANE HEADERS -->
        <mxCell id="h_renter" value="Renter" style="shape=mxgraph.flowchart.annotation_2;align=center;labelPosition=center;pointerEvents=1;fontSize=14;fontStyle=1;verticalAlign=middle;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_manager" value="Manager / Owner" style="shape=mxgraph.flowchart.annotation_2;align=center;labelPosition=center;pointerEvents=1;fontSize=14;fontStyle=1;verticalAlign=middle;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="60" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_staff" value="Staff" style="shape=mxgraph.flowchart.annotation_2;align=center;labelPosition=center;pointerEvents=1;fontSize=14;fontStyle=1;verticalAlign=middle;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_system" value="OWRMS System" style="shape=mxgraph.flowchart.annotation_2;align=center;labelPosition=center;pointerEvents=1;fontSize=14;fontStyle=1;verticalAlign=middle;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="60" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Lane backgrounds -->
        <mxCell id="bg1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCC;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="200" height="2810" as="geometry" />
        </mxCell>
        <mxCell id="bg2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCC;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="200" height="2810" as="geometry" />
        </mxCell>
        <mxCell id="bg3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCC;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="90" width="200" height="2810" as="geometry" />
        </mxCell>
        <mxCell id="bg4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCC;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="90" width="200" height="2810" as="geometry" />
        </mxCell>

        <!-- START -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000;strokeColor=#000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="130" y="110" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- ═══ PHASE 1: CREATE REQUEST ═══ -->

        <mxCell id="R1" value="Select warehouse &amp;&#xa;add items to inbound list&#xa;(name, qty, unit, weight,&#xa;estimated area)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="55" y="150" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e01" style="" edge="1" source="start" target="R1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R2" value="Submit inbound request&#xa;(Type: INBOUND)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="55" y="240" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e02" style="" edge="1" source="R1" target="R2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- System validates -->
        <mxCell id="SYS1" value="Validate request:&#xa;• Active contract exists?&#xa;• Weight within floor limit?&#xa;• Volume warning check&#xa;Generate RequestCode&#xa;Create WarehouseTask" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="715" y="230" width="170" height="95" as="geometry" />
        </mxCell>
        <mxCell id="e03" style="" edge="1" source="R2" target="SYS1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Smart routing decision -->
        <mxCell id="SYS_route" value="AI volume&#xa;data&#xa;available?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="765" y="360" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e04" style="" edge="1" source="SYS1" target="SYS_route" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- AUTO-APPROVE PATH -->
        <mxCell id="SYS_auto" value="Auto-approve:&#xa;Status → CONFIRMED&#xa;Complete approve task&#xa;Send confirmation email" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="715" y="470" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e05" value="Yes &amp; within&#xa;capacity" style="fontSize=10;" edge="1" source="SYS_route" target="SYS_auto" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MANUAL APPROVE PATH -->
        <mxCell id="SYS_pending" value="Status → PENDING&#xa;Send pending email&#xa;to Renter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="715" y="575" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e06" value="No (manual&#xa;required)" style="fontSize=10;" edge="1" source="SYS_route" target="SYS_pending" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900" y="395" />
              <mxPoint x="900" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Manager receives pending -->
        <mxCell id="M1" value="Receive &amp; review&#xa;pending inbound request&#xa;(check volume warning)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="275" y="575" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e07" style="" edge="1" source="SYS_pending" target="M1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Manager decision -->
        <mxCell id="M2" value="Approve?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="325" y="660" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e08" style="" edge="1" source="M1" target="M2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Reject path -->
        <mxCell id="M_reject" value="Reject request&#xa;(enter reason)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="275" y="760" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e09" value="No" style="" edge="1" source="M2" target="M_reject" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="SYS_rejected" value="Status → REJECTED&#xa;Notify Renter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="715" y="760" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="" edge="1" source="M_reject" target="SYS_rejected" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R_rejected" value="View rejection&#xa;notification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="55" y="765" width="170" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="" edge="1" source="SYS_rejected" target="R_rejected" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="end_reject" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000;strokeColor=#000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="127" y="820" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="" edge="1" source="R_rejected" target="end_reject" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Approve path -->
        <mxCell id="M_approve" value="Approve request&#xa;(sign, add note)&#xa;Status → CONFIRMED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="275" y="870" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="Yes" style="" edge="1" source="M2" target="M_approve" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="250" y="690" />
              <mxPoint x="250" y="895" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="SYS_approved_email" value="Send approval email&#xa;to Renter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="715" y="880" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="" edge="1" source="M_approve" target="SYS_approved_email" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MERGE: Auto-approve + Manual approve -->
        <mxCell id="merge1" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#000;strokeColor=#000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="347" y="960" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="e15" style="" edge="1" source="SYS_auto" target="merge1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="560" />
              <mxPoint x="920" y="560" />
              <mxPoint x="920" y="940" />
              <mxPoint x="355" y="940" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e16" style="" edge="1" source="M_approve" target="merge1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══ PHASE 2: ASSIGN STAFF (optional) ═══ -->

        <mxCell id="M_assign_check" value="Assign&#xa;staff?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="325" y="1010" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e17" style="" edge="1" source="merge1" target="M_assign_check" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="M_assign" value="Assign staff to request&#xa;Status → ASSIGNED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="275" y="1100" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="Yes" style="" edge="1" source="M_assign_check" target="M_assign" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Skip assign → staff picks up -->
        <mxCell id="merge2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#000;strokeColor=#000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="567" y="1140" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="e19" value="No (any staff)" style="fontSize=10;" edge="1" source="M_assign_check" target="merge2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="1040" />
              <mxPoint x="460" y="1148" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e20" style="" edge="1" source="M_assign" target="merge2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══ PHASE 3: STAFF RECEIVES GOODS ═══ -->

        <mxCell id="R_deliver" value="Deliver goods&#xa;to warehouse&#xa;(offline)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="55" y="1190" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e21" style="dashed=1;strokeColor=#999;" edge="1" source="merge2" target="R_deliver" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ST1" value="Receive job assignment&#xa;or pick up task" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="495" y="1195" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e22" style="" edge="1" source="merge2" target="ST1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ST2" value="Receive &amp; count goods&#xa;(verify quantity,&#xa;measure area &amp; weight)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="495" y="1270" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e23" style="" edge="1" source="ST1" target="ST2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══ PHASE 4: CREATE RECEIPT NOTE ═══ -->

        <mxCell id="ST3" value="Create Receipt Note&#xa;(enter verified qty,&#xa;measured area/weight,&#xa;staff signature)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="495" y="1355" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e24" style="" edge="1" source="ST2" target="ST3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Capacity guard -->
        <mxCell id="SYS_cap" value="Capacity&#xa;check?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="765" y="1365" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e25" style="" edge="1" source="ST3" target="SYS_cap" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- GREEN: within capacity -->
        <mxCell id="SYS_green" value="Within capacity&#xa;Receipt → VERIFIED&#xa;Update inventory&#xa;Create transaction record" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="715" y="1480" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e26" value="Within limit" style="fontSize=10;" edge="1" source="SYS_cap" target="SYS_green" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- YELLOW: minor overflow ≤ 2m² -->
        <mxCell id="SYS_yellow" value="Minor overflow (≤ 2m²)&#xa;Staff confirms acceptance&#xa;Receipt → VERIFIED&#xa;Update inventory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="715" y="1580" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e27" value="≤ 2m² over&#xa;(staff accepts)" style="fontSize=10;" edge="1" source="SYS_cap" target="SYS_yellow" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="910" y="1400" />
              <mxPoint x="910" y="1612" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- RED: major overflow > 2m² -->
        <mxCell id="SYS_red" value="Major overflow (&gt; 2m²)&#xa;Receipt →&#xa;PENDING_CAPACITY_APPROVAL&#xa;Inventory NOT updated yet" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="715" y="1685" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e28" value="&gt; 2m² over&#xa;(hard block)" style="fontSize=10;" edge="1" source="SYS_cap" target="SYS_red" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="920" y="1400" />
              <mxPoint x="920" y="1718" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Manager approves capacity -->
        <mxCell id="M_cap" value="Review capacity alert&#xa;Approve or reject&#xa;over-capacity receipt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="275" y="1690" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e29" style="" edge="1" source="SYS_red" target="M_cap" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="M_cap_dec" value="Approve?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="330" y="1770" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e30" style="" edge="1" source="M_cap" target="M_cap_dec" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="SYS_cap_approved" value="Receipt → VERIFIED&#xa;Update inventory&#xa;Create transaction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="715" y="1780" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e31" value="Yes" style="" edge="1" source="M_cap_dec" target="SYS_cap_approved" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="SYS_cap_reject" value="Receipt → REJECTED&#xa;Goods returned to Renter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#F5F5F5;strokeColor=#999;fontColor=#666;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="1860" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e32" value="No" style="dashed=1;strokeColor=#999;" edge="1" source="M_cap_dec" target="SYS_cap_reject" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══ PHASE 5: REQUEST STATUS → RECEIVING / COMPLETED ═══ -->

        <!-- Merge all success paths -->
        <mxCell id="merge3" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#000;strokeColor=#000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="792" y="1870" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="e33" style="" edge="1" source="SYS_green" target="merge3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" style="" edge="1" source="SYS_yellow" target="merge3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e35" style="" edge="1" source="SYS_cap_approved" target="merge3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="SYS_receiving" value="Request Status → RECEIVING&#xa;(multiple receipt notes&#xa;may be created)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="715" y="1920" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e36" style="" edge="1" source="merge3" target="SYS_receiving" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- All items done check -->
        <mxCell id="ST_all_done" value="All items&#xa;received?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="545" y="1920" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e37" style="" edge="1" source="SYS_receiving" target="ST_all_done" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Loop back for more receipt notes -->
        <mxCell id="e38" value="No (more&#xa;deliveries)" style="curved=1;fontSize=10;" edge="1" source="ST_all_done" target="ST2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="1950" />
              <mxPoint x="480" y="1295" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Staff confirms completion -->
        <mxCell id="ST_confirm" value="Confirm request completion&#xa;(staff signature)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="495" y="2020" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e39" value="Yes" style="" edge="1" source="ST_all_done" target="ST_confirm" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- System completes -->
        <mxCell id="SYS_complete" value="Request Status → COMPLETED&#xa;Record all transactions&#xa;Update warehouse inventory&#xa;Update renter inventory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="715" y="2010" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e40" style="" edge="1" source="ST_confirm" target="SYS_complete" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Renter confirmation -->
        <mxCell id="R_done" value="View completed&#xa;inbound request&#xa;(inventory history)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="2020" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e41" style="" edge="1" source="SYS_complete" target="R_done" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000;strokeColor=#000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="127" y="2100" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="e42" style="" edge="1" source="R_done" target="end" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
