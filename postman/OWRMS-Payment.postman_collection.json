        {
          "name": "Owner Confirm Cash Approve",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenOwner}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isApproved\": true,\n  \"rejectionReason\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/payments/{{cashPaymentIdApprove}}/confirm"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Confirm cash approve status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Cash Payment For Reject",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRenter}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractId\": {{contractIdPayment}},\n  \"paymentType\": \"MONTHLY\",\n  \"paymentMethod\": \"CASH\",\n  \"amount\": {{monthlyPayment}},\n  \"status\": \"PENDING_CONFIRMATION\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/payments/cash"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create cash payment reject path 200/201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const b = pm.response.json();",
                  "const id = b.paymentId ?? b.id ?? b.data?.paymentId ?? b.data?.id;",
                  "pm.expect(id, 'Missing cashPaymentIdReject').to.exist;",
                  "pm.collectionVariables.set('cashPaymentIdReject', String(id));"
                ]
              }
            }
          ]
        },
