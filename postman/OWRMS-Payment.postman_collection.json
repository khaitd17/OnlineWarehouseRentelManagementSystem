        {
          "name": "Simulate SePay Webhook",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('webhookTransactionId', String(Date.now()));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{webhookTransactionId}},\n  \"gateway\": \"SEPAY\",\n  \"transactionDate\": \"{{runAt}}\",\n  \"accountNumber\": \"1234567890\",\n  \"code\": \"00\",\n  \"content\": \"{{paymentCodeBank}}\",\n  \"transferType\": \"IN\",\n  \"transferAmount\": {{depositAmount}},\n  \"accumulated\": {{depositAmount}},\n  \"subAccount\": null,\n  \"referenceCode\": \"PM-{{webhookTransactionId}}\",\n  \"description\": \"Postman webhook simulation\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/payments/sepay-webhook"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Webhook status 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "const success = b.success ?? b.Success;",
                  "if (success !== undefined) {",
                  "  pm.test('Webhook success type boolean', function () { pm.expect(typeof success).to.eql('boolean'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate Webhook Same Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{webhookTransactionId}},\n  \"gateway\": \"SEPAY\",\n  \"transactionDate\": \"{{runAt}}\",\n  \"accountNumber\": \"1234567890\",\n  \"code\": \"00\",\n  \"content\": \"{{paymentCodeBank}}\",\n  \"transferType\": \"IN\",\n  \"transferAmount\": {{depositAmount}},\n  \"accumulated\": {{depositAmount}},\n  \"subAccount\": null,\n  \"referenceCode\": \"PM-{{webhookTransactionId}}\",\n  \"description\": \"Postman duplicate webhook simulation\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/payments/sepay-webhook"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate webhook still 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Payment Status After Webhook",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRenter}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/payments/{{paymentIdBank}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status endpoint after webhook 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "const status = String(b.status ?? b.Status ?? b.data?.status ?? '').toUpperCase();",
                  "pm.expect(status, 'Payment status missing').to.not.eql('');",
                  "pm.test('Status is valid', function () {",
                  "  pm.expect(['PENDING', 'COMPLETED', 'FAILED', 'EXPIRED', 'PENDING_CONFIRMATION']).to.include(status);",
                  "});",
                  "const attempt = Number(pm.collectionVariables.get('paymentStatusPollAttempt') || '0');",
                  "if (status !== 'COMPLETED' && attempt < 3) {",
                  "  pm.collectionVariables.set('paymentStatusPollAttempt', String(attempt + 1));",
                  "  postman.setNextRequest('Get Payment Status After Webhook');",
                  "} else {",
                  "  pm.collectionVariables.unset('paymentStatusPollAttempt');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Payments By Contract",
          "request": {
