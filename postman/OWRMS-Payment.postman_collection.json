    {
      "name": "02 - Bank Transfer Flow",
      "item": [
        {
          "name": "Create Bank Transfer Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRenter}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractId\": {{contractIdPayment}},\n  \"paymentType\": \"DEPOSIT\",\n  \"paymentMethod\": \"BANK_TRANSFER\",\n  \"amountOverride\": {{depositAmount}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/payments/create"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create bank payment status 200/201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const b = pm.response.json();",
                  "const paymentId = b.paymentId ?? b.id ?? b.data?.paymentId ?? b.data?.id;",
                  "const paymentCode = b.paymentCode ?? b.code ?? b.data?.paymentCode;",
                  "pm.expect(paymentId, 'Missing paymentIdBank').to.exist;",
                  "pm.expect(paymentCode, 'Missing paymentCodeBank').to.exist;",
                  "pm.collectionVariables.set('paymentIdBank', String(paymentId));",
                  "pm.collectionVariables.set('paymentCodeBank', String(paymentCode));",
                  "pm.environment.set('paymentId', String(paymentId));",
                  "pm.environment.set('paymentCode', String(paymentCode));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get QR Info",
