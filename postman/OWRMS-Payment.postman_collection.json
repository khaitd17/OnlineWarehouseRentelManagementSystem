          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Approve payment scenario status 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "const contractId = b.contractId ?? b.id ?? b.data?.contractId ?? b.data?.id ?? b.result?.contractId;",
                  "pm.expect(contractId, 'Missing contractIdPayment').to.exist;",
                  "pm.collectionVariables.set('contractIdPayment', String(contractId));",
                  "pm.environment.set('contractId', String(contractId));"
                ]
              }
            }
          ]
        },
