    },
    {
      "name": "04 - Retry And Security",
      "item": [
        {
          "name": "Retry Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRenter}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/payments/{{paymentIdBank}}/retry"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retry returns known code', function () { pm.expect([200, 400, 404, 409]).to.include(pm.response.code); });",
                  "if ([200, 400, 409].includes(pm.response.code)) {",
                  "  const b = pm.response.json();",
                  "  const success = b.success ?? b.Success;",
                  "  if (success !== undefined) {",
                  "    pm.test('Retry success key is boolean', function () { pm.expect(typeof success).to.eql('boolean'); });",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Payment Invalid Method (Expect 400/422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRenter}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractId\": {{contractIdPayment}},\n  \"paymentType\": \"DEPOSIT\",\n  \"paymentMethod\": \"INVALID_METHOD\",\n  \"amountOverride\": {{depositAmount}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/payments/create"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid method should fail', function () { pm.expect([400, 422]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Payment Without Token (Expect 401/403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractId\": {{contractIdPayment}},\n  \"paymentType\": \"DEPOSIT\",\n  \"paymentMethod\": \"BANK_TRANSFER\",\n  \"amountOverride\": {{depositAmount}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/payments/create"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthorized expected', function () { pm.expect([401, 403]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Renter Confirm Cash (Expect 401/403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRenter}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isApproved\": true,\n  \"rejectionReason\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/payments/{{cashPaymentIdReject}}/confirm"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Renter confirm cash should be blocked', function () { pm.expect([401, 403]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        }
      ]
    }
