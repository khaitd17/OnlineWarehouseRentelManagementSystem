                "type": "text/javascript",
                "exec": [
                  "pm.test('Approve request status 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "const contractId = b.contractId ?? b.id ?? b.data?.contractId ?? b.data?.id ?? b.result?.contractId;",
                  "pm.expect(contractId, 'Missing contractId from approve').to.exist;",
                  "pm.collectionVariables.set('contractIdFromApprove', String(contractId));",
