        {
          "name": "Unauthorized Create Request (Expect 401/403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": {{warehouseId}},\n  \"requestedArea\": {{requestedArea}},\n  \"startDate\": \"{{startDate}}\",\n  \"durationMonths\": {{durationMonths}},\n  \"notes\": \"Unauthorized should fail\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/rental-requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
