{
  "info": {
    "_postman_id": "e804f72a-5ae1-4dcf-9bc2-40d20abca8bd",
    "name": "OWRMS - Rental API Full Test",
    "description": "Full rental request feature tests: create, send, approve, reject, cancel, and owner/renter views.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('startDate') || pm.environment.get('startDate') === 'AUTO') {",
          "  const d = new Date();",
          "  d.setDate(d.getDate() + 7);",
          "  pm.environment.set('startDate', d.toISOString());",
          "}",
          "if (!pm.environment.get('requestNotes')) {",
          "  pm.environment.set('requestNotes', 'Postman rental flow test');",
          "}",
          "if (!pm.environment.get('rejectReason')) {",
          "  pm.environment.set('rejectReason', 'Area does not match current availability');",
          "}",
          "if (!pm.environment.get('cancelReason')) {",
          "  pm.environment.set('cancelReason', 'User changed plan before contract signing');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "tokenRenter", "value": "" },
    { "key": "tokenOwner", "value": "" },
    { "key": "warehouseId", "value": "" },
    { "key": "rentalAreaId", "value": "" },
    { "key": "requestIdApprove", "value": "" },
    { "key": "requestIdReject", "value": "" },
    { "key": "requestIdCancel", "value": "" },
    { "key": "contractIdFromApprove", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Login Renter",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{renterEmail}}\",\n  \"password\": \"{{renterPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login renter status 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "const token = b.token ?? b.Token ?? b.data?.token ?? b.data?.Token;",
                  "pm.expect(token, 'Missing renter token').to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('tokenRenter', token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Owner",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login owner status 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "const token = b.token ?? b.Token ?? b.data?.token ?? b.data?.Token;",
                  "pm.expect(token, 'Missing owner token').to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('tokenOwner', token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Warehouse Context",
      "item": [
        {
          "name": "Get Approved Warehouses",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/warehouse/approved?limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Approved warehouse status 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "const list = Array.isArray(b) ? b : (b.data ?? b.items ?? b.result ?? b.warehouses ?? []);",
                  "pm.expect(Array.isArray(list), 'Warehouse list should be array').to.eql(true);",
                  "pm.expect(list.length, 'No approved warehouse found').to.be.greaterThan(0);",
                  "const w = list[0];",
                  "const warehouseId = w.id ?? w.warehouseId ?? w.Id ?? w.WarehouseId;",
                  "pm.expect(warehouseId, 'Missing warehouseId').to.exist;",
                  "pm.collectionVariables.set('warehouseId', String(warehouseId));",
                  "pm.environment.set('warehouseId', String(warehouseId));",
                  "const areas = w.rentalAreas ?? w.RentalAreas ?? w.areas ?? w.Areas ?? [];",
                  "if (Array.isArray(areas) && areas.length > 0) {",
                  "  const areaId = areas[0].id ?? areas[0].rentalAreaId ?? areas[0].Id ?? areas[0].RentalAreaId;",
                  "  if (areaId) {",
                  "    pm.collectionVariables.set('rentalAreaId', String(areaId));",
                  "    pm.environment.set('rentalAreaId', String(areaId));",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Search Approved Warehouses",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/warehouse/approved/search?page=1&pageSize=12&sortBy=newest"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Search status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Warehouse Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/warehouse/{{warehouseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Warehouse detail status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Approve Scenario",
      "item": [
        {
          "name": "Create Request For Approve",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const warehouseId = Number(pm.collectionVariables.get('warehouseId') || pm.environment.get('warehouseId'));",
                  "pm.expect(warehouseId, 'warehouseId is required').to.be.a('number').and.not.NaN;",
                  "const payload = {",
                  "  warehouseId: warehouseId,",
                  "  requestedArea: Number(pm.environment.get('requestedArea')),",
                  "  startDate: pm.environment.get('startDate'),",
                  "  durationMonths: Number(pm.environment.get('durationMonths')),",
                  "  notes: pm.environment.get('requestNotes')",
                  "};",
                  "const areaRaw = pm.collectionVariables.get('rentalAreaId') || pm.environment.get('rentalAreaId');",
                  "if (areaRaw) { payload.rentalAreaId = Number(areaRaw); }",
                  "pm.variables.set('createRequestApproveBody', JSON.stringify(payload, null, 2));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRenter}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{createRequestApproveBody}}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/rental-requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create request status 200/201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
                  "const b = pm.response.json();",
                  "const id = b.requestId ?? b.id ?? b.data?.requestId ?? b.data?.id ?? b.result?.id;",
                  "pm.expect(id, 'Missing requestIdApprove').to.exist;",
                  "pm.collectionVariables.set('requestIdApprove', String(id));"
