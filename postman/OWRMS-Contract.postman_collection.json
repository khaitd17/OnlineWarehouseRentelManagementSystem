    {
      "name": "03 - Decline And Extension",
      "item": [
        {
          "name": "Decline Contract",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRenter}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"{{declineReason}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/rental-contracts/{{contractIdDecline}}/decline"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Decline contract status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Declined Contract Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRenter}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/rental-contracts/{{contractIdDecline}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Declined contract detail status 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "const status = String(b.status ?? b.Status ?? b.data?.status ?? '').toUpperCase();",
                  "pm.test('Declined-like status', function () {",
                  "  pm.expect(['DECLINED', 'CANCELLED', 'REJECTED']).to.include(status);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Try Owner Sign Declined Contract (Expect Fail)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenOwner}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signatureBase64\": \"{{signatureBase64}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/rental-contracts/{{contractIdDecline}}/owner-sign"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sign declined contract should fail', function () { pm.expect([400, 404, 409]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Extend Signed Contract",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenOwner}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"extensionMonths\": {{extensionMonths}},\n  \"additionalMonthlyPayment\": {{additionalMonthlyPayment}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/rental-contracts/{{contractIdSign}}/extend"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Extend returns known status', function () { pm.expect([200, 400, 404, 409]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthorized Get Contract (Expect 401/403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rental-contracts/{{contractIdSign}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthorized expected', function () { pm.expect([401, 403]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
