<mxfile host="app.diagrams.net" agent="Antigravity" version="26.0">
  <diagram id="payment-workflow" name="Contract Payment Workflow">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="Online Warehouse Rental Management System&#xa;Contract Payment Workflow" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="380" height="40" as="geometry" />
        </mxCell>

        <!-- SWIM LANE HEADERS -->
        <mxCell id="header_renter" value="Renter" style="shape=mxgraph.flowchart.annotation_2;align=center;labelPosition=center;pointerEvents=1;fontSize=14;fontStyle=1;verticalAlign=middle;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="header_system" value="OWRMS System" style="shape=mxgraph.flowchart.annotation_2;align=center;labelPosition=center;pointerEvents=1;fontSize=14;fontStyle=1;verticalAlign=middle;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="header_owner" value="Warehouse Owner" style="shape=mxgraph.flowchart.annotation_2;align=center;labelPosition=center;pointerEvents=1;fontSize=14;fontStyle=1;verticalAlign=middle;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="header_gateway" value="Payment Gateway&#xa;(SePay)" style="shape=mxgraph.flowchart.annotation_2;align=center;labelPosition=center;pointerEvents=1;fontSize=14;fontStyle=1;verticalAlign=middle;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="60" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Lane backgrounds -->
        <mxCell id="bg_renter" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCCCCC;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="220" height="2510" as="geometry" />
        </mxCell>
        <mxCell id="bg_system" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCCCCC;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="90" width="220" height="2510" as="geometry" />
        </mxCell>
        <mxCell id="bg_owner" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCCCCC;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="90" width="220" height="2510" as="geometry" />
        </mxCell>
        <mxCell id="bg_gateway" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCCCCC;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="90" width="200" height="2510" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- START                                   -->
        <!-- ═══════════════════════════════════════ -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="380" y="110" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- CONTRACT ACTIVE → INVOICE               -->
        <!-- ═══════════════════════════════════════ -->

        <mxCell id="S1" value="Contract is ACTIVE&#xa;First-term invoice created&#xa;(Deposit + Monthly amount)&#xa;PaymentCode generated" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="150" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e01" style="" edge="1" source="start" target="S1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R1" value="View invoice details&#xa;on contract page" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="165" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e02" style="" edge="1" source="S1" target="R1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- CHOOSE PAYMENT METHOD                   -->
        <!-- ═══════════════════════════════════════ -->

        <mxCell id="R2" value="Choose&#xa;payment&#xa;method" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="115" y="240" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e03" style="" edge="1" source="R1" target="R2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- PATH A: ONLINE BANK TRANSFER (VIA SEPAY QR)    -->
        <!-- ═══════════════════════════════════════════════ -->

        <mxCell id="R3" value="Choose Online&#xa;(Bank Transfer)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="350" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e04" value="Online" style="" edge="1" source="R2" target="R3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S2" value="Generate VietQR code&#xa;with PaymentCode&#xa;and payment amount" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="345" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e05" style="" edge="1" source="R3" target="S2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R4" value="Scan QR code &amp; transfer&#xa;payment via banking app&#xa;(content includes&#xa;PaymentCode)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="420" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e06" style="" edge="1" source="S2" target="R4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="G1" value="Receive incoming&#xa;bank transfer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="790" y="430" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e07" style="" edge="1" source="R4" target="G1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="150" y="500" />
              <mxPoint x="860" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="G2" value="Send webhook to&#xa;OWRMS System&#xa;(TransferType: &quot;in&quot;,&#xa;Content: PaymentCode)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="790" y="520" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e08" style="" edge="1" source="G1" target="G2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S3" value="Process SePay Webhook:&#xa;Match PaymentCode&#xa;Update payment →&#xa;COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="525" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e09" style="" edge="1" source="G2" target="S3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TIMEOUT CHECK -->
        <mxCell id="S_timeout" value="Payment&#xa;expired?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="355" y="620" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="" edge="1" source="S3" target="S_timeout" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Not expired → proceed to activation -->
        <mxCell id="e11" value="No (paid on time)" style="" edge="1" source="S_timeout" target="S_activate" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Expired → check retry -->
        <mxCell id="S_expired" value="Payment status → EXPIRED&#xa;Notify Renter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="630" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="Yes (timeout)" style="" edge="1" source="S_timeout" target="S_expired" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R_expired" value="Receive notification:&#xa;payment has expired" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="635" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="" edge="1" source="S_expired" target="R_expired" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R_retry_check" value="Retry&#xa;count&#xa;&lt; 3?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="115" y="710" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="" edge="1" source="R_expired" target="R_retry_check" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R_retry" value="Request payment retry" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="820" width="170" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="Yes" style="" edge="1" source="R_retry_check" target="R_retry" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S_retry" value="Reset payment → PENDING&#xa;Increment retry count&#xa;Set new expiry (24h)&#xa;Generate new QR code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="810" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="" edge="1" source="R_retry" target="S_retry" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Loop back to R4 (scan QR) -->
        <mxCell id="e17" value="" style="curved=1;" edge="1" source="S_retry" target="R4" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="240" y="840" />
              <mxPoint x="240" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Max retry reached -->
        <mxCell id="S_max_retry" value="Max retry reached&#xa;Contract →&#xa;CANCELLED_NO_PAYMENT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="915" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="No (max reached)" style="" edge="1" source="R_retry_check" target="S_max_retry" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="50" y="745" />
              <mxPoint x="50" y="940" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="end_max_retry" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="378" y="990" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="e19" style="" edge="1" source="S_max_retry" target="end_max_retry" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- PATH B: CASH / MANUAL BANK TRANSFER            -->
        <!-- ═══════════════════════════════════════════════ -->

        <mxCell id="R5" value="Choose Cash /&#xa;Manual Transfer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="1080" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e20" value="Cash / Manual" style="" edge="1" source="R2" target="R5" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="275" />
              <mxPoint x="40" y="1100" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="R6" value="Submit payment proof&#xa;(transaction code,&#xa;receipt photo, note)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="1150" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e21" style="" edge="1" source="R5" target="R6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S5" value="Create payment with&#xa;PENDING_CONFIRMATION&#xa;status&#xa;Send notification to Owner" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="1145" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e22" style="" edge="1" source="R6" target="S5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="O1" value="Receive payment&#xa;confirmation request&#xa;(review proof)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="1150" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e23" style="" edge="1" source="S5" target="O1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Owner decision -->
        <mxCell id="O2" value="Confirm&#xa;payment?" style="rhombus;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="595" y="1240" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e24" style="" edge="1" source="O1" target="O2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- REJECT PAYMENT -->
        <mxCell id="O3" value="Reject payment&#xa;(enter reason)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="1360" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e25" value="No" style="" edge="1" source="O2" target="O3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="S6" value="Payment → CANCELLED&#xa;Send rejection notification&#xa;to Renter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="1355" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e26" style="" edge="1" source="O3" target="S6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R7" value="Receive rejection&#xa;notification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="1360" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e27" style="" edge="1" source="S6" target="R7" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Loop back to resubmit -->
        <mxCell id="e28" value="Renter can resubmit&#xa;payment proof" style="curved=1;dashed=1;strokeColor=#999999;fontStyle=2;fontSize=10;fontColor=#666666;" edge="1" source="R7" target="R6" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="50" y="1380" />
              <mxPoint x="50" y="1175" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- REQUEST REUPLOAD -->
        <mxCell id="O4" value="Request proof reupload&#xa;(enter reason)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="1450" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e29" value="Request reupload" style="dashed=1;fontStyle=2;fontSize=10;" edge="1" source="O2" target="O4" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="1275" />
              <mxPoint x="750" y="1470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="S7" value="Payment →&#xa;REUPLOAD_REQUESTED&#xa;Send notification to Renter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="1445" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e30" style="" edge="1" source="O4" target="S7" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R8" value="Receive reupload request&#xa;with reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="65" y="1455" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e31" style="" edge="1" source="S7" target="R8" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Loop back to resubmit proof -->
        <mxCell id="e32" style="curved=1;" edge="1" source="R8" target="R6" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="1475" />
              <mxPoint x="40" y="1175" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- APPROVE PAYMENT -->
        <mxCell id="S_cash_complete" value="Payment → COMPLETED&#xa;(ConfirmCashPayment)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="1565" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e33" value="Yes (Approve)" style="" edge="1" source="O2" target="S_cash_complete" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="1275" />
              <mxPoint x="540" y="1585" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- MERGE: BOTH PATHS → POST-PAYMENT ACTIVATION    -->
        <!-- ═══════════════════════════════════════════════ -->

        <mxCell id="merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="380" y="1660" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Online path → merge -->
        <mxCell id="e34" value="(from Online path)" style="fontStyle=2;fontSize=9;fontColor=#999999;" edge="1" source="S_timeout" target="merge" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="270" y="655" />
              <mxPoint x="270" y="1670" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Cash path → merge -->
        <mxCell id="e35" style="" edge="1" source="S_cash_complete" target="merge" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ACTIVATION label target -->
        <mxCell id="S_activate" value="Deduct rented area from&#xa;warehouse available area&#xa;Grant RENTER membership&#xa;in warehouse" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="305" y="1710" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e36" style="" edge="1" source="merge" target="S_activate" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════ -->
        <!-- SEND CONFIRMATION                       -->
        <!-- ═══════════════════════════════════════ -->

        <mxCell id="S_email" value="Send payment success&#xa;email &amp; notification&#xa;to Renter &amp; Owner" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="305" y="1810" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e37" style="" edge="1" source="S_activate" target="S_email" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="R_success" value="Receive confirmation:&#xa;payment successful&#xa;Warehouse access granted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="1900" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e38" style="" edge="1" source="S_email" target="R_success" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="O_success" value="Receive confirmation:&#xa;payment successful" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="545" y="1900" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e39" style="" edge="1" source="S_email" target="O_success" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="end_success" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="137" y="1980" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="e40" style="" edge="1" source="R_success" target="end_success" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
